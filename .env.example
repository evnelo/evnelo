# Edition: self_hosted | cloud
EDITION=self_hosted
APP_URL=http://localhost:3000
AUTH_SECRET=change-me-32-bytes-min

# MySQL 8
DATABASE_URL=mysql://openticket:openticket@localhost:3306/openticket

# Stripe (self-hosted: your own account keys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Cloud only: Connect client id for "connect your Stripe account"
STRIPE_CONNECT_CLIENT_ID=

# Vonage (transactional SMS)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=OpenTicket

# Resend (transactional email)
RESEND_API_KEY=re_xxx
EMAIL_FROM="OpenTicket <tickets@example.com>"

# Storage: local | s3
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional geocoding
MAPBOX_TOKEN=
