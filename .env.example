# Edition: self_hosted | cloud
EDITION=self_hosted
APP_URL=http://localhost:3000
AUTH_SECRET=change-me-32-bytes-min

# Google sign-in (optional). OAuth client from console.cloud.google.com, redirect URI
# {APP_URL}/api/auth/callback/google. Magic-link email sign-in always works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MySQL 8
DATABASE_URL=mysql://openticket:openticket@localhost:3306/openticket

# Public API per-client throttling. Leave empty to ignore all forwarding headers (safe but all
# clients share one bucket). Behind a trusted proxy, choose the one header that the proxy overwrites:
# cf-connecting-ip | x-real-ip | x-forwarded-for
API_TRUSTED_PROXY_HEADER=

# Stripe (self-hosted: your own account keys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Cloud only: Connect client id for "connect your Stripe account"
STRIPE_CONNECT_CLIENT_ID=

# Vonage (transactional SMS). Either an Application ID + its private key (Messages API,
# PEM contents, base64 or a file path) or the legacy API key + secret.
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=OpenTicket

# Resend (transactional email). The webhook secret verifies delivery/bounce events
# posted to /api/webhooks/resend (Resend dashboard → Webhooks).
RESEND_API_KEY=re_xxx
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="OpenTicket <tickets@example.com>"

# Vonage webhooks: set the application's status URL to /api/webhooks/vonage/status and its
# inbound URL to /api/webhooks/vonage/inbound (STOP handling). The signature secret
# (dashboard → Settings) verifies them; leave empty to skip verification.
VONAGE_SIGNATURE_SECRET=

# Notification worker. "true" runs it inside the web process every 10s (self-hosted default).
# On serverless hosts set "false" and POST /api/jobs/run with "Authorization: Bearer $AUTH_SECRET" from a cron.
JOBS_INLINE=true

# Storage: local | s3
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional geocoding
MAPBOX_TOKEN=

# Apple Wallet passes (optional). Pass Type ID certificate + private key from developer.apple.com,
# and Apple's WWDR G4 certificate. Values are PEM contents (newlines as \n) or paths to PEM files.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT=

# Google Wallet passes (optional). Issuer ID from the Google Pay & Wallet Console, and a service
# account JSON with the Wallet API enabled (contents or path).
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT=
