# Edition: self_hosted | cloud
EDITION=self_hosted
APP_URL=http://localhost:3000
AUTH_SECRET=change-me-32-bytes-min

# Google sign-in (optional). OAuth client from console.cloud.google.com, redirect URI
# {APP_URL}/api/auth/callback/google. Magic-link email sign-in always works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MySQL 8
DATABASE_URL=mysql://evnelo:evnelo@localhost:3306/evnelo

# Public API per-client throttling. Leave empty to ignore all forwarding headers (safe but all
# clients share one bucket). Behind a trusted proxy, choose the one header that the proxy overwrites:
# cf-connecting-ip | x-real-ip | x-forwarded-for
# Also used for the per-client limits on registration and sign-in links, so set it in production.
API_TRUSTED_PROXY_HEADER=

# Where "Report this event" submissions are emailed (they are always stored in event_reports).
ABUSE_EMAIL=

# Bot check on sign-in links, registrations, waitlist joins and abuse reports (optional, recommended
# in production). "turnstile" (Cloudflare, free, invisible for most people) or "recaptcha" (Google
# reCAPTCHA v3). Off until all three are set. The site key is public; the secret stays on the server.
CAPTCHA_PROVIDER=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Error reporting (optional). SENTRY_DSN is read at runtime by the server; NEXT_PUBLIC_SENTRY_DSN is
# inlined into the browser bundle at build time, so pass it as a build argument for Docker images.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Stripe (self-hosted: your own account keys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Cloud only: Connect client id for "connect your Stripe account"
STRIPE_CONNECT_CLIENT_ID=

# Vonage (transactional SMS). Either an Application ID + its private key (Messages API,
# PEM contents, base64 or a file path) or the legacy API key + secret.
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=Evnelo

# Resend (transactional email). The webhook secret verifies delivery/bounce events
# posted to /api/webhooks/resend (Resend dashboard → Webhooks).
RESEND_API_KEY=re_xxx
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Evnelo <tickets@evnelo.com>"

# Vonage webhooks: set the application's status URL to /api/webhooks/vonage/status and its
# inbound URL to /api/webhooks/vonage/inbound (STOP handling). The signature secret
# (dashboard → Settings) verifies them; leave empty to skip verification.
VONAGE_SIGNATURE_SECRET=

# Notification worker. "true" runs it inside the web process every 10s (self-hosted default).
# On serverless hosts set "false" and POST /api/jobs/run with "Authorization: Bearer $AUTH_SECRET" from a cron.
JOBS_INLINE=true
# Apply pending migrations when the server boots (the Docker image sets this to true; several
# replicas may boot at once, a MySQL lock serialises them). Otherwise run `pnpm db:migrate`.
MIGRATE_ON_START=false

# Image uploads (event covers and logos) go straight from the browser to S3 with a presigned
# POST. Any S3-compatible bucket works (set S3_ENDPOINT for R2/MinIO). Objects must be publicly
# readable (bucket policy or CloudFront); the bucket's CORS must allow POST from APP_URL.
# With CLOUDFRONT_DOMAIN set, stored image URLs use it instead of the bucket address.
# Every key is written under S3_KEY_PREFIX (default "evnelo") so the bucket can be shared.
# The SDK-standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION names work too.
# Leave empty to disable uploads; the editor then accepts image URLs.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_KEY_PREFIX=evnelo
# Set to public-read if your bucket still uses object ACLs (no public bucket policy or CloudFront
# origin access). Leave empty for buckets with ACLs disabled, where an ACL makes uploads fail.
S3_UPLOAD_ACL=
CLOUDFRONT_DOMAIN=

# Address autocomplete in the event editor. "photon" uses komoot's public OpenStreetMap instance
# (no key needed; venue addresses being typed are sent there), "mapbox" needs MAPBOX_TOKEN,
# "none" turns it off. PHOTON_URL points at a self-hosted Photon if you run one.
GEOCODER=photon
PHOTON_URL=https://photon.komoot.io
MAPBOX_TOKEN=

# Wallet passes (optional; the buttons appear only when configured). Apple: Pass Type ID certificate
# and key (PEM contents or base64), the Apple WWDR certificate and your team id. Google: the Wallet
# issuer id and a service-account JSON (contents or base64).
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT=
